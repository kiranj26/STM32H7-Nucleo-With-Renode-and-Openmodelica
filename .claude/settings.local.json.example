  "//": "Copy to .claude/settings.local.json (gitignored) for personal, machine-specific overrides. Remove this key.",
  "permissions": {
    "allow": [
      "Bash(make hw:*)",
      "Bash(st-flash write:*)",
      "Bash(git commit:*)"
