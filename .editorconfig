root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{yml,yaml,json}]
indent_size = 2

[*.{mo,mos}]
indent_size = 2

[Makefile]
indent_style = tab

[*.md]
trim_trailing_whitespace = false

# CubeMX output: leave as generated
[fw/*/{Drivers,cmake/stm32cubemx}/**]
indent_style = unset
indent_size = unset
trim_trailing_whitespace = false
insert_final_newline = unset
